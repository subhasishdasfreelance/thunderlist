{
	"name": "thunderlist",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 4000",
		"devstart": "vite dev --port 4000",
		"generate-routes": "tsr generate",
		"build": "astryx theme build src/theme/thunderlist.theme.ts && vite build",
		"theme:build": "astryx theme build src/theme/thunderlist.theme.ts",
		"theme:check": "astryx theme build --check src/theme/thunderlist.theme.ts",
		"preview": "vite preview --port 4000",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"claim-data": "bun --env-file=.env.local scripts/claim-data.ts"
	},
	"dependencies": {
		"@astryxdesign/core": "^0.5.4",
		"@stylexjs/stylex": "^0.19.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-query": "latest",
		"@tanstack/react-query-devtools": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "latest",
		"better-auth": "^1.5.3",
		"lucide-react": "^1.42.0",
		"mongodb": "^6",
		"nitro": "3.0.260610-beta",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@astryxdesign/cli": "^0.5.4",
		"@biomejs/biome": "2.4.5",
		"@tanstack/devtools-vite": "latest",
		"@tanstack/router-cli": "^1.132.0",
		"@types/bun": "^1.4.1",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	}
}
