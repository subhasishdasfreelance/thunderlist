# ---------------------------------------------------------------------------
# Thunderlist environment
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# The MongoDB connection string, e.g. from Atlas:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# The database itself is always `thunderlist`; any database named in the
# connection string is ignored.
MONGO_CONN_STR=

# ---------------------------------------------------------------------------
# Better Auth (already part of this project)
# ---------------------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=